APP_NAME=Short Drama Data Management and Analysis System
APP_ENV=development
DATABASE_URL=mysql+pymysql://YOUR_USERNAME:YOUR_PASSWORD@127.0.0.1:3306/short_drama_analysis?charset=utf8mb4
# Optional fail-closed bundle for one audited legacy Revision population.
# Leave every field unset unless the target database fingerprint was verified.
# DATA_QUALITY_LEGACY_REVISION_DATABASE=short_drama_analysis
# DATA_QUALITY_LEGACY_REVISION_MAX_ID=<AUDITED_MAX_REVISION_ID>
# DATA_QUALITY_LEGACY_REVISION_EXPECTED_COUNT=<AUDITED_REVISION_COUNT>
# DATA_QUALITY_LEGACY_REVISION_EXPECTED_MIN_CHANGED_AT=<AUDITED_NAIVE_DATETIME>
# DATA_QUALITY_LEGACY_REVISION_EXPECTED_MAX_CHANGED_AT=<AUDITED_NAIVE_DATETIME>
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
TOKEN_EXPIRE_MINUTES=30
